{
  "name": "lune-shell-inspector",
  "version": "1.0.0",
  "description": "Shell dock and /shell inspector for pi's background bash jobs",
  "type": "module",
  "main": "src/index.ts",
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "test": "node --experimental-strip-types --test 'test/**/*.test.ts'",
    "typecheck": "tsc --noEmit",
    "tui:demo": "node --experimental-strip-types test/tui/launch.ts"
  },
  "keywords": [
    "pi-package"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.86.0",
    "@earendil-works/pi-tui": "^0.86.0",
    "@xterm/headless": "^6.0.0",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.86.0",
    "@types/node": "^22.20.2",
    "typescript": "5.9.3"
  }
}
